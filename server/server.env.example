# ⚠️ RENOMBRA ESTE ARCHIVO A  .env.example  Y COLÓCALO EN  server/
# Copia después a server/.env con tus valores reales. El .env NO se sube al repo.

# Puerto en el que escucha la API
PORT=4000

# Cadena de conexión de MongoDB Atlas
# Sustituye USUARIO, CONTRASENA y el host por los de tu cluster
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/skinshelf?retryWrites=true&w=majority

# Origen permitido por CORS
# En local: http://localhost:5173 — en producción: la URL de tu frontend en Vercel
CORS_ORIGIN=http://localhost:5173
